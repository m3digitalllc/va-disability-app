.env
.env.local
*.pyc
__pycache__/
.venv/
node_modules/
.next/
backend/data/
*.enc
nginx/certs/
.security-audits/
# Compose-mounted secrets — never commit values. The directory itself plus
# README.md and .gitkeep are tracked; everything else under secrets/ is ignored.
secrets/*
!secrets/.gitkeep
!secrets/README.md
